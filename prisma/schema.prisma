generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StoreCategory {
  FAST_FOOD
  GROCERY
  CLOTHING
  RESTAURANT
  PHARMACY
  ELECTRONICS
  HOME_GOODS
  ONLINE
  OTHER
}

enum GiftCardStatus {
  ACTIVE
  PARTIALLY_REDEEMED
  FULLY_REDEEMED
  DONATED
}

enum TransactionType {
  SPEND
  DONATION_OUT
}

enum UserRole {
  ADMIN
  VOLUNTEER
}

model Store {
  id        String        @id @default(uuid())
  name      String        @unique
  category  StoreCategory
  logoUrl   String?
  giftCards GiftCard[]
}

model GiftCard {
  id              String         @id @default(uuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  lastFourDigits  String         @db.VarChar(4)
  initialAmount   Decimal        @db.Decimal(10, 2)
  remainingAmount Decimal        @db.Decimal(10, 2)
  status          GiftCardStatus
  notes           String?
  createdAt       DateTime       @default(now())
  transactions    Transaction[]

  @@unique([storeId, lastFourDigits])
}

model Transaction {
  id            String          @id @default(uuid())
  giftCardId    String
  giftCard      GiftCard        @relation(fields: [giftCardId], references: [id])
  amount        Decimal         @db.Decimal(10, 2)
  type          TransactionType
  recipientName String?
  volunteerName String?
  createdAt     DateTime        @default(now())
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(VOLUNTEER)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Meet — ImportStaging contract (add when staging model exists):
// - batchId String @map("batch_id")  →  FK to ImportBatch.id
// - batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
// - ImportBatch: add importStagings ImportStaging[]
// ImportBatch.id is a UUID string (TEXT), same pattern as Store / GiftCard.

model ImportBatch {
  id           String   @id @default(uuid())
  fileName     String   @map("file_name")
  /// Allowed values enforced in DB: pending | processing | completed | failed
  status       String   @default("pending")
  rowCount     Int?     @map("row_count")
  successCount Int?     @map("success_count")
  errorCount   Int?     @map("error_count")
  errorSummary String?  @map("error_summary") @db.Text
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("import_batches")
}
