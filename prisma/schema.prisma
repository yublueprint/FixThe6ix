generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id        String        @id @default(uuid())
  name      String        @unique
  category  StoreCategory
  logoUrl   String?
  giftCards GiftCard[]
}

model GiftCard {
  id              String         @id @default(uuid())
  storeId         String
  lastFourDigits  String         @db.VarChar(4)
  initialAmount   Decimal        @db.Decimal(10, 2)
  remainingAmount Decimal        @db.Decimal(10, 2)
  status          GiftCardStatus
  notes           String?
  createdAt       DateTime       @default(now())
  store           Store          @relation(fields: [storeId], references: [id])
  transactions    Transaction[]

  @@unique([storeId, lastFourDigits])
}

model Transaction {
  id            String          @id @default(uuid())
  giftCardId    String
  amount        Decimal         @db.Decimal(10, 2)
  type          TransactionType
  recipientName String?
  volunteerName String?
  createdAt     DateTime        @default(now())
  giftCard      GiftCard        @relation(fields: [giftCardId], references: [id])
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(VOLUNTEER)
  status        UserStatus @default(ACTIVE)
  roleRequest   Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ImportBatch {
  id             String          @id @default(uuid())
  fileName       String          @map("file_name")
  /// Allowed values enforced in DB: pending | processing | completed | failed
  status         String          @default("pending")
  rowCount       Int?            @map("row_count")
  successCount   Int?            @map("success_count")
  errorCount     Int?            @map("error_count")
  errorSummary   String?         @map("error_summary")
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  importStagings ImportStaging[]

  @@index([status])
  @@index([createdAt])
  @@map("import_batches")
}

model ImportStaging {
  id                String      @id @default(uuid())
  batchId           String      @map("batch_id")
  rawStore          String      @map("raw_store")
  rawLast4          String      @map("raw_last4")
  rawAmount         String      @map("raw_amount")
  rawNotes          String?     @map("raw_notes")
  rawAddedBy        String?     @map("raw_added_by")
  rawDateAdded      String?     @map("raw_date_added")
  rowNumber         Int         @map("row_number")
  status            String      @default("pending")
  validationErrors  Json?       @map("validation_errors")
  resolvedStoreId   String?     @map("resolved_store_id")
  resolvedLast4     String?     @map("resolved_last4")
  resolvedAmount    Decimal?    @map("resolved_amount") @db.Decimal(10, 2)
  resolvedDateAdded DateTime?   @map("resolved_date_added")
  promotedCardId    String?     @map("promoted_card_id")
  promotedAt        DateTime?   @map("promoted_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  batch             ImportBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([status])
  @@index([batchId, status])
  @@map("import_staging")
}

enum StoreCategory {
  FAST_FOOD
  GROCERY
  CLOTHING
  RESTAURANT
  PHARMACY
  ELECTRONICS
  HOME_GOODS
  ONLINE
  OTHER
}

enum GiftCardStatus {
  ACTIVE
  PARTIALLY_REDEEMED
  FULLY_REDEEMED
  DONATED
}

enum TransactionType {
  SPEND
  DONATION_OUT
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VOLUNTEER
}

enum UserStatus {
  INVITED
  ACTIVE
}
